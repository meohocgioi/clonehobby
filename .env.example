# ---- Telegram (required) ----
TELEGRAM_BOT_TOKEN=123456:ABC...
# @channelusername or numeric id (-100...). The bot must be an ADMIN of the channel with "Post messages".
TELEGRAM_CHAT_ID=@your_channel

# ---- Source site ----
SITE_BASE=https://www.toy-people.com/en/
SITEMAP_URL=https://www.toy-people.com/sitemap/sitemap-en.xml
SITE_TZ=Asia/Taipei
# seconds between polls of the sitemap
POLL_INTERVAL_SECONDS=300
# politeness delay between requests to the website
SITE_DELAY_SECONDS=1.5

# ---- Posting pace (Telegram anti-spam) ----
# Minimum seconds between two posts. Telegram allows ~20 msgs/min per chat; 45 s is very conservative.
POST_DELAY_SECONDS=45
# 0 = no hourly cap
MAX_POSTS_PER_HOUR=0

# ---- First start ----
# On the very first Start, every post already on the site is marked "seen" (NOT posted) so the channel is not flooded.
# Set to N to also post the N most recent posts on first start.
INITIAL_POST_LATEST=0
# Safety: if more than this many unseen posts appear in ONE poll, they are not auto-queued (looks like a site reshuffle)
MAX_AUTO_QUEUE=60

# ---- Message format ----
MAX_MEDIA=50
# auto: try image URLs, fall back to uploading downloaded files | url | upload
MEDIA_MODE=auto
# false: show tags exactly as on the web   true: #Japanese_Series style (clickable in Telegram)
HASHTAG_STYLE=plain
# link the H3 title to the original web post (makes the channel scannable for duplicates)
LINK_TITLE=true
SHOW_MORE_LABEL=Show More

# ---- Cloudflare ----
# auto | http | browser | flaresolverr
FETCH_BACKEND=auto
FLARESOLVERR_URL=
# optional outbound proxy for site requests, e.g. http://user:pass@host:port
PROXY_URL=

# ---- App ----
# DB_PATH=data/tpclone.db
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Password for the dashboard. If WEB_HOST is not localhost and this is empty, one is generated
# and saved in data/dashboard_password.txt
WEB_TOKEN=
# resume automatically after a reboot if it was running when it stopped
AUTO_RESUME=true
DRY_RUN=false
# Only if you run your own Bot API server
# TELEGRAM_API_BASE=https://api.telegram.org
